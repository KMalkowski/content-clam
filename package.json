{
  "name": "content-clam",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:extension": "pnpm --filter @content-clam/extension dev",
    "dev:backend": "pnpm --filter @content-clam/backend dev",
    "dev:web": "pnpm --filter @content-clam/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "jev:smoke": "tsx scripts/jev-smoke.mjs",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
